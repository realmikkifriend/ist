{
    "name": "ist-alpine",
    "version": "1.0.0",
    "description": "Ist is a micro-app that reads your task list from [Todoist](https://todoist.com/), then displays the most important task that can currently be worked on.",
    "scripts": {
        "start": "vite --open",
        "build": "vite build",
        "test": "svelte-check && vitest run",
        "test:coverage": "svelte-check && vitest run --coverage",
        "test:watch": "npx playwright test --ui",
        "test:coverage:watch": "vitest --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint 'src/**/*.{svelte,ts}' 'tests/e2e/**/*.ts' 'playwright.config.ts'",
        "depcruiser": "depcruise src --include-only '^src' --output-type x-dot-webpage -f dependencies.htm",
        "knip": "knip",
        "scan": "npm run depcruiser --silent && svelte-check && npm run knip --silent && npm run lint --silent && npm run test:e2e"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/realmikkifriend/ist.git"
    },
    "author": "realmikkifriend",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/realmikkifriend/ist/issues"
    },
    "homepage": "https://github.com/realmikkifriend/ist#readme",
    "engines": {
        "node": "26.x"
    },
    "dependenciesComments": {
        "typescript": "held below TS 7: svelte-check (latest 4.x) only peer-allows ^5 || ^6. TS no longer emits for the build (webpack/ts-loader removed in Phase 3), so no webpack pin remains."
    },
    "dependencies": {
        "@doist/todoist-sdk": "^15.3.1",
        "@fontsource/clear-sans": "^5.2.5",
        "@humanspeak/svelte-markdown": "^1.9.5",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "chrono-node": "^2.8.3",
        "luxon": "^3.7.1",
        "svelte": "^5.0.0",
        "svelte-dnd-action": "^0.9.64",
        "svelte-hero-icons": "^5.2.0",
        "svelte-persisted-store": "^0.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@svelte-put/shortcut": "^4.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.2.8",
        "@types/luxon": "^3.7.6",
        "@types/node": "^26.6.3",
        "@vitest/coverage-v8": "^5.0.2",
        "@vitest/eslint-plugin": "^1.6.27",
        "daisyui": "^5.7.47",
        "dependency-cruiser": "^18.4.0",
        "eslint": "^10.11.0",
        "eslint-plugin-functional": "^10.0.1",
        "eslint-plugin-jsdoc": "^65.0.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "knip": "^6.38.0",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte-check": "^4.3.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "overrides": {
        "deepmerge-ts": "^8.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
