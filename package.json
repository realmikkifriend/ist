{
    "name": "ist-alpine",
    "version": "1.0.0",
    "description": "Ist is a micro-app that reads your task list from [Todoist](https://todoist.com/), then displays the most important task that can currently be worked on.",
    "scripts": {
        "start": "dotenv -- webpack serve --open --mode development --no-stats",
        "build": "webpack --mode production",
        "test": "svelte-check && vitest run",
        "test:coverage": "svelte-check && vitest run --coverage",
        "test:watch": "npx playwright test --ui",
        "test:coverage:watch": "vitest --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint 'src/**/*.{svelte,ts}' 'tests/e2e/**/*.ts' 'playwright.config.ts'",
        "depcruiser": "depcruise src --include-only '^src' --output-type x-dot-webpage -f dependencies.htm",
        "knip": "knip",
        "scan": "npm run depcruiser --silent && svelte-check && npm run knip --silent && npm run lint --silent"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/realmikkifriend/ist.git"
    },
    "author": "realmikkifriend",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/realmikkifriend/ist/issues"
    },
    "homepage": "https://github.com/realmikkifriend/ist#readme",
    "engines": {
        "node": "26.x"
    },
    "dependenciesComments": {
        "webpack": "caret-ranged at ^5.111.x; must stay >=5.101 for webpack-dev-server 6. (Console Ninja removed; old 5.99.8 pin dropped)",
        "typescript": "locked at 5.8.2 as webpack dependency"
    },
    "dependencies": {
        "@doist/todoist-sdk": "^15.3.1",
        "@fontsource/clear-sans": "^5.2.5",
        "@humanspeak/svelte-markdown": "^1.9.5",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "chrono-node": "^2.8.3",
        "luxon": "^3.7.1",
        "svelte": "^5.0.0",
        "svelte-dnd-action": "^0.9.64",
        "svelte-hero-icons": "^5.2.0",
        "svelte-loader": "^3.2.4",
        "svelte-persisted-store": "^0.12.0",
        "webpack": "^5.111.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@svelte-put/shortcut": "^4.1.0",
        "@sveltejs/vite-plugin-svelte": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.4",
        "@testing-library/svelte": "^5.2.8",
        "@types/luxon": "^3.7.1",
        "@types/node": "^26.6.3",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "autoprefixer": "^10.4.21",
        "css-loader": "^7.1.2",
        "daisyui": "^5.0.50",
        "dependency-cruiser": "^18.4.0",
        "dotenv-cli": "^10.0.0",
        "dotenv-webpack": "^8.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-functional": "^9.0.2",
        "eslint-plugin-jsdoc": "^65.0.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "html-webpack-plugin": "^5.6.3",
        "jsdom": "^30.1.1",
        "knip": "^6.38.0",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.1.1",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "style-loader": "^4.0.0",
        "svelte-check": "^4.3.0",
        "svelte-preprocess": "^6.0.3",
        "tailwindcss": "^4.1.11",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.71.0",
        "vitest": "^3.2.4",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^6.0.0"
    }
}
