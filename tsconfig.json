{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        // Nothing emits JS to disk anymore: Vite transforms at build time and
        // svelte-check only typechecks.
        "noEmit": true,
        "jsx": "preserve",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "types": ["vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.svelte",
        "src/types/**/*.ts",
        "tests/**/*.ts",
        "playwright.config.ts",
        "knip.ts"
    ],
    "exclude": ["node_modules"]
}
